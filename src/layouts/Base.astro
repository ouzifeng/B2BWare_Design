---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = '/images/og-default.jpg', noindex = false } = Astro.props;

// Dev server and any build with PUBLIC_NOINDEX=true (staging) stay out of search.
const blockIndex = noindex || import.meta.env.DEV || import.meta.env.PUBLIC_NOINDEX === 'true';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const pageName = title.replace(/\s*\|\s*B2Bware\s*$/, '');

// Breadcrumbs: Home, then a section index where one exists, then this page.
const sections: Record<string, string> = { industries: 'Industries', features: 'Features', compare: 'Compare' };
const parts = path.split('/').filter(Boolean);
const crumbs = [{ name: 'Home', url: new URL('/', Astro.site).href }];
if (parts.length > 1 && sections[parts[0]]) crumbs.push({ name: sections[parts[0]], url: new URL('/' + parts[0], Astro.site).href });
if (parts.length) crumbs.push({ name: pageName, url: canonical });

const org = {
  '@type': 'Organization',
  '@id': 'https://b2bware.com/#organization',
  name: 'B2Bware',
  url: 'https://b2bware.com/',
  parentOrganization: { '@type': 'Organization', name: 'SyncSpider GmbH' },
  address: { '@type': 'PostalAddress', streetAddress: 'Molkereistraße 4', postalCode: '4910', addressLocality: 'Ried im Innkreis', addressCountry: 'AT' },
  sameAs: ['https://www.linkedin.com/company/b2bware/', 'https://x.com/b2bware', 'https://www.instagram.com/b2bware/', 'https://www.reddit.com/r/B2Bware/'],
};
const graph: object[] = [];
if (!parts.length) graph.push(org, { '@type': 'WebSite', '@id': 'https://b2bware.com/#website', name: 'B2Bware', url: 'https://b2bware.com/', publisher: { '@id': 'https://b2bware.com/#organization' } });
if (parts.length) graph.push({ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) });
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en-GB" data-wf-domain="b2bware.webflow.io" data-wf-page="6ac1edc0f53a15e44f0f4374" data-wf-site="6ab6d727ad6f02478d295bd5">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={blockIndex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="B2Bware" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@b2bware" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <script is:inline src="/js/b2bwarenavigationmobilestyles.js" type="text/javascript"></script>
    <link rel="stylesheet" href="/css/webflow.css" />
    <link rel="stylesheet" href="/css/page.css" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script is:inline src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/js/webflow.js" type="text/javascript"></script>
    <script is:inline src="/js/b2bwarenavigation.js" type="text/javascript"></script>
    <script is:inline src="/js/b2bwareaccordion.js" type="text/javascript"></script>
    <script is:inline src="/js/b2bwarelocaleswitcher.js" type="text/javascript"></script>
    <slot name="foot" />
  </body>
</html>
