---
import Base from '../layouts/Base.astro';
import SegHero from '../components/segments/SegHero.astro';
import Section from '../components/ui/Section.astro';
import OrderCheck from '../components/OrderCheck.astro';
import { orderCheck } from '../data/b2b';
import { compareHero } from '../data/compare';
import { glossary, glossaryIntro, grouped, letters, slugify } from '../data/glossary';

const present = new Set(grouped.map((g) => g.letter));
const SITE = 'https://b2bware.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'B2B glossary',
  url: `${SITE}/b2b-glossary`,
  hasDefinedTerm: glossary.map((g) => ({
    '@type': 'DefinedTerm',
    name: g.term,
    description: g.definition,
    url: `${SITE}/b2b-glossary#${slugify(g.term)}`,
    inDefinedTermSet: `${SITE}/b2b-glossary`,
  })),
};
const start = ['Contract-based catalogue', 'ERP integration', 'Emailed order', 'Tiered pricing', 'Single source of truth (SSOT)'];
---
<Base title="B2B glossary: trade ordering and ERP terms | B2Bware" description="Plain definitions of B2B ordering, portal and ERP integration terms, A to Z, with links to the matching B2Bware pages.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/seg-common.css" />
    <link rel="stylesheet" href="/css/glossary.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <SegHero
    tone="light"
    headline={glossaryIntro.title}
    highlight={glossaryIntro.highlight}
    checks={[`${glossary.length} terms, A to Z`, 'One or two sentences each', 'Links to our pages where they exist']}
    lead={glossaryIntro.lead}
    primaryCta={compareHero.primaryCta}
    secondaryCta={{ text: 'Jump to A to Z', href: '#gl-az' }}
    priceLine={compareHero.priceLine}
    priceNote={compareHero.priceNote}
  >
    <div class="ui-card gl-start">
      <p class="gl-start_title">Common starting points</p>
      <ul role="list" class="gl-start_list">
        {start.map((t) => <li><a href={`#${slugify(t)}`}>{t}<span aria-hidden="true"> →</span></a></li>)}
      </ul>
    </div>
  </SegHero>

  <Section id="gl-az" tone="light">
    <nav class="gl-jump" aria-label="Jump to letter">
      {letters.map((l) => present.has(l)
        ? <a href={`#letter-${l}`} class="gl-jump_a">{l}</a>
        : <span class="gl-jump_a is-off" aria-hidden="true">{l}</span>)}
    </nav>
    <div class="gl-list">
      {grouped.map((g) => (
        <section class="gl-group" id={`letter-${g.letter}`} aria-labelledby={`h-${g.letter}`}>
          <h2 class="gl-letter" id={`h-${g.letter}`}>{g.letter}</h2>
          <dl class="gl-terms">
            {g.terms.map((t) => (
              <div class="gl-term" id={slugify(t.term)}>
                <dt>{t.term}</dt>
                <dd>
                  {t.definition}
                  {t.link && <> <a class="seg-link" href={t.link.href}>{t.link.text} <span aria-hidden="true">→</span></a></>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </Section>

  <OrderCheck data={orderCheck} />
</Base>
