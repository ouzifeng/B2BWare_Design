---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'default' | 'large';
}
const { href, variant = 'primary', size = 'default' } = Astro.props;
const cls = ['button', variant === 'secondary' && 'is-secondary', size === 'large' && 'is-large'].filter(Boolean).join(' ');
---
<a href={href} class={cls}><slot /></a>
