---
import Card from './Card.astro';

interface Props {
  tag: string;
  title: string;
  text: string;
  cta?: { text: string; href: string };
}
const { tag, title, text, cta } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const titleHtml = title
  .split(/(Free|£[\d,]+)/)
  .map((part, i) => (i % 2 === 1 ? `<span class="price-card_fig">${esc(part)}</span>` : esc(part)))
  .join('');
---
<Card class="price-card">
  <h3 class="heading-h3" set:html={titleHtml} />
  <p class="price-card_note">{tag}</p>
  <p class="card_text">{text}</p>
  {cta && <a href={cta.href} class="route-link price-card_cta">{cta.text}</a>}
</Card>
