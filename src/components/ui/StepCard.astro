---
interface Props {
  number: number | string;
  title: string;
  text: string;
  free?: boolean;
}
const { number, title, text, free = false } = Astro.props;
---
<div class="step-card">
  <div class="step-num">{number}</div>
  <h3 class="heading-h3">{title}</h3>
  <p class="card_text">{text}</p>
  {free && <div class="step-free">Free</div>}
</div>
