---
// Hero mock: a consumer product page next to the ERP record it reads from.
---
<div class="b2c-shop">
  <div class="b2c-win" role="img" aria-label="Illustrative consumer product page showing a price including VAT and live stock from the ERP">
    <div class="b2c-win_bar" aria-hidden="true"><span></span><span></span><span></span><em>yourshop.co.uk/stoneware-mug</em></div>
    <div class="b2c-pdp">
      <div class="b2c-photo" aria-hidden="true">
        <svg viewBox="0 0 120 120" width="120" height="120" fill="none"><ellipse cx="58" cy="100" rx="40" ry="7" fill="#0A2540" opacity=".08"/><path d="M26 34h64v44a26 26 0 0 1-26 26H52A26 26 0 0 1 26 78V34Z" fill="#fff" stroke="#0A2540" stroke-width="2.5"/><path d="M90 46h8a12 12 0 0 1 0 24h-8" stroke="#0A2540" stroke-width="2.5" stroke-linecap="round"/><path d="M26 52h64" stroke="#08A270" stroke-width="2.5"/></svg>
        <span>Product photo</span>
      </div>
      <div class="b2c-pdp_info">
        <p class="b2c-pdp_cat">Kitchen and dining</p>
        <h3 class="b2c-pdp_name">Stoneware mug, blue</h3>
        <p class="b2c-pdp_price"><strong>£24.00</strong> <span>incl. VAT</span></p>
        <p class="b2c-stock"><i aria-hidden="true"></i>In stock: 12, live from your ERP</p>
        <div class="b2c-pdp_row"><span class="b2c-qty">1</span><span class="b2c-btn">Add to basket</span></div>
      </div>
    </div>
  </div>
  <div class="b2c-erpchip" aria-hidden="true">
    <p class="b2c-erpchip_h">In your ERP</p>
    <dl>
      <div><dt>Price</dt><dd>£24.00 incl. VAT</dd></div>
      <div><dt>Stock</dt><dd>12</dd></div>
    </dl>
    <p class="b2c-erpchip_ok"><svg viewBox="0 0 22 22" width="16" height="16" fill="none"><circle cx="11" cy="11" r="11" fill="#08A270"/><path d="M6.5 11.2 9.6 14.3 15.5 8.2" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Same as the shop</p>
  </div>
  <p class="ord-caption b2c-caption">Illustrative example.</p>
</div>
