---
import Section from '../ui/Section.astro';
interface Props { data: { title: string; lines: string[]; variant?: 'bubbles' | 'alerts' | 'chips' } }
const { data } = Astro.props;
const v = data.variant;
// Decorative icons for the chips variant (no copy): file, code, box, price, stop.
const chipIcons = [
  'M5 2.5h7l4 4v11H5z M12 2.5v4h4 M8 10h5 M8 13h5',
  'M8 5l-5 5 5 5 M12 5l5 5-5 5',
  'M3 7l7-3.5L17 7v7l-7 3.5L3 14z M3 7l7 3.5L17 7 M10 10.5v7',
  'M13.5 6c-.8-1.2-2-1.8-3.4-1.8-1.900 0-3.200 1.100-3.200 2.700 0 3 6.600 1.600 6.600 5 0 1.700-1.400 2.800-3.400 2.800-1.500 0-2.800-.7-3.600-1.900 M4.500 10h8',
  'M7 2.5h6l4.500 4.500v6L13 17.500H7L2.500 13V7z M7 7l6 6 M13 7l-6 6',
];
---
<Section title={data.title}>
  {v === 'bubbles' && (
    <ul role="list" class="sym-bubbles">
      {data.lines.map((l, i) => (
        <li class:list={['sym-bubble', i % 2 ? 'is-right' : 'is-left']}>
          <span class="sym-bubble_av" aria-hidden="true">
            {i % 2
              ? <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M2.5 4.5h15v11h-15z M2.5 5l7.5 6 7.5-6" /></svg>
              : <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M5 2.5h3l1.500 4-2 1.300a9 9 0 0 0 4.700 4.700l1.300-2 4 1.500v3a2 2 0 0 1-2 2A13 13 0 0 1 3 4.500a2 2 0 0 1 2-2z" /></svg>}
          </span>
          <span class="sym-bubble_text">{l}</span>
        </li>
      ))}
    </ul>
  )}
  {v === 'alerts' && (
    <ul role="list" class="sym-alerts">
      {data.lines.map((l) => (
        <li class="sym-alert"><span class="sym-alert_dot" aria-hidden="true"></span><span class="sym-alert_text">{l}</span></li>
      ))}
    </ul>
  )}
  {v === 'chips' && (
    <ul role="list" class="sym-chips">
      {data.lines.map((l, i) => (
        <li class:list={['sym-chip', `is-${i + 1}`]}>
          <svg class="sym-chip_icon" viewBox="0 0 20 20" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={chipIcons[i % chipIcons.length]} /></svg>
          <span class="sym-chip_text">{l}</span>
        </li>
      ))}
    </ul>
  )}
</Section>
