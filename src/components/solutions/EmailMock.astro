  </div>
  <div class="em_arrow" aria-hidden="true"><svg viewBox="0 0 24 28" width="24" height="28"><path fill="none" stroke="#08A270" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M5 16l7 8 7-8"/></svg></div>
