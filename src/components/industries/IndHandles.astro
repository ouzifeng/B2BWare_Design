---
import Section from '../ui/Section.astro';
import { bySlug } from '../../data/industries';
interface Props { slug: string }
const ind = bySlug(Astro.props.slug);
---
<Section id="ind-handles" tone="white" title={ind.handlesTitle} intro="All of it runs on one connection to your ERP, and we run it for you.">
  <ul role="list" class="ind-handles">
    {ind.handles.map((h) => (
      <li class="ind-handles_item">
        <svg class="ind-handles_tick" fill="none" viewBox="0 0 22 22" height="20" width="20" aria-hidden="true"><circle fill="#08A270" r="11" cy="11" cx="11"></circle><path stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="#fff" d="M6.5 11.2 9.6 14.3 15.5 8.2"></path></svg>
        <div>
          <h3 class="ind-handles_title">{h.title}</h3>
          <p class="ind-handles_text">{h.text}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>
